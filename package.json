{
  "name": "minigame-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "离线单机轻量小游戏合集 Monorepo —— 支持小红书小工具、Bilibili Toy、微信小程序及 GitHub Pages 静态部署",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @minigame/one-rope-two-baskets dev",
    "dev:one-rope": "pnpm --filter @minigame/one-rope-two-baskets dev",
    "dev:puzzle-card": "pnpm --filter @minigame/puzzle-card dev",
    "build": "pnpm -r build",
    "build:pages": "pnpm build && node ./scripts/build-pages.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "pack:one-rope": "pnpm --filter @minigame/one-rope-two-baskets pack:platforms",
    "pack:puzzle-card": "pnpm --filter @minigame/puzzle-card pack:xhs",
    "new-game": "node packages/build-tools/src/scaffold-game.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
