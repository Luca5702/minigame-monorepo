.shell { height: 100vh; display: flex; flex-direction: column; background: #5a371c; color: #382110; position: relative; }
.top-bar { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 20rpx; background: linear-gradient(180deg, #6b4323 0%, #533218 100%); border-bottom: 4rpx solid #382110; color: #fdf6ea; }
.level-btn { display: flex; align-items: center; gap: 10rpx; font-size: 26rpx; font-weight: bold; background: linear-gradient(180deg, #eed5b2 0%, #d4aa78 100%); color: #382110; border: 3rpx solid #382110; border-radius: 14rpx; padding: 6rpx 14rpx; box-shadow: 0 4rpx 0 #38200e; }
.ch-tag { background: #825024; color: #fff8eb; padding: 2rpx 10rpx; border-radius: 8rpx; font-size: 20rpx; }
.metrics { display: flex; align-items: center; gap: 12rpx; }
.dots-row { display: flex; gap: 8rpx; background: #38200e; padding: 8rpx 14rpx; border-radius: 999rpx; }
.g-dot { width: 16rpx; height: 16rpx; border-radius: 50%; border: 3rpx solid rgba(255,232,192,0.45); }
.g-dot.done { background: #4ee093; border-color: #d6ffea; }
.chip { font-size: 22rpx; font-weight: bold; background: #38200e; color: #f4e6cf; padding: 5rpx 12rpx; border-radius: 10rpx; }

.floating-toast { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 540rpx; z-index: 28; padding: 36rpx 48rpx 30rpx; border-radius: 28rpx; background: linear-gradient(180deg, #fff8df 0%, #f5dc9b 100%); border: 4rpx solid #382110; box-shadow: 0 18rpx 44rpx rgba(28,14,4,0.42); font-size: 25rpx; font-weight: bold; color: #4d2907; display: flex; flex-direction: column; align-items: center; gap: 18rpx; text-align: center; }
.floating-toast.warn { background: linear-gradient(180deg, #fff3ee 0%, #fad8cd 100%); color: #b83d27; }
.toast-body { line-height: 1.45; }
.toast-close { position: absolute; top: 12rpx; right: 12rpx; width: 42rpx; height: 42rpx; border-radius: 50%; background: #eed5b2; border: 3rpx solid #382110; color: #382110; font-size: 22rpx; display: flex; align-items: center; justify-content: center; }
.toast-undo-btn { background: linear-gradient(180deg, #eed5b2 0%, #d4aa78 100%); border: 3rpx solid #382110; color: #382110; font-size: 22rpx; padding: 8rpx 22rpx; border-radius: 14rpx; box-shadow: 0 4rpx 0 #38200e; }

.hoist-frame { flex: 1; margin: 10rpx 18rpx 8rpx; border: 5rpx solid #382110; border-radius: 24rpx; display: flex; flex-direction: column; overflow: hidden; background: #f9f1e2; }
.pulley-rig { height: 104rpx; background: linear-gradient(180deg, #dfd0ba 0%, #efe4d2 100%); border-bottom: 4rpx solid #382110; position: relative; display: flex; align-items: center; justify-content: center; }
.attic-beam { position: absolute; top: 10rpx; left: 10rpx; right: 10rpx; height: 48rpx; border-radius: 10rpx; background: linear-gradient(180deg, #d1995e 0%, #825024 100%); border-top: 3rpx solid #382110; border: 3rpx solid #382110; }
.top-rope { position: absolute; top: 32rpx; left: 100rpx; right: 100rpx; height: 10rpx; background: repeating-linear-gradient(60deg, #8c5928 0rpx 8rpx, #dfad5b 8rpx 16rpx); border-top: 2rpx solid #382110; border-bottom: 2rpx solid #382110; z-index: 2; }
.seesaw-box { position: relative; z-index: 3; width: 236rpx; height: 74rpx; margin-top: 12rpx; background: #fbf3df; border: 3rpx solid #382110; border-radius: 20rpx 20rpx 10rpx 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding-bottom: 6rpx; box-shadow: 0 3rpx 6rpx rgba(32,16,4,0.22); }
.seesaw-beam { width: 196rpx; height: 34rpx; display: flex; align-items: flex-end; justify-content: space-between; border-bottom: 5rpx solid #382110; padding: 0 6rpx 4rpx; transition: transform 0.32s ease; }
.pan { display: flex; gap: 4rpx; align-items: flex-end; }
.pan-r { justify-content: flex-end; }
.p-brick { width: 14rpx; height: 18rpx; border-radius: 3rpx; border: 2rpx solid #382110; }
.p-a { background: #5c9e98; }
.p-b { background: #d87a58; }
.pan-empty { width: 12rpx; height: 4rpx; background: #cbb89d; }
.fulcrum { width: 0; height: 0; border-left: 10rpx solid transparent; border-right: 10rpx solid transparent; border-bottom: 12rpx solid #382110; margin-top: 2rpx; }

.stage-body { position: relative; flex: 1; }
.rope-strand { position: absolute; top: 0; width: 10rpx; background: repeating-linear-gradient(30deg, #8c5928 0rpx 8rpx, #dfad5b 8rpx 16rpx); border-left: 2rpx solid #382110; border-right: 2rpx solid #382110; z-index: 2; transition: height 0.42s ease; }
.rope-left { left: 95rpx; }
.rope-right { right: 95rpx; }
.no-trans { transition: none !important; }

.carriage { position: absolute; width: 186rpx; height: calc(33.3333% - 14rpx); z-index: 5; border-radius: 14rpx; padding: 4rpx 6rpx 4rpx; display: flex; flex-direction: column; transition: top 0.42s ease; border: 4rpx solid #382110; box-shadow: 0 8rpx 14rpx rgba(28,14,4,0.28); }
.carriage-left { left: 7rpx; background: linear-gradient(180deg, #5c9e98 0%, #417d78 100%); }
.carriage-right { right: 7rpx; background: linear-gradient(180deg, #d87a58 0%, #b85838 100%); }
.b-head { display: flex; justify-content: space-between; align-items: center; font-size: 20rpx; font-weight: bold; padding: 2rpx 6rpx 4rpx; color: #fff9ed; }
.b-dir { font-weight: 900; }
.mass-cells { display: flex; gap: 4rpx; }
.m-cell { width: 15rpx; height: 15rpx; border-radius: 3rpx; background: rgba(28,16,6,0.38); border: 2rpx solid #382110; }
.m-cell.lit { background: #f2be49; }

.tut-drag-pill { position: absolute; top: 42%; left: 50%; transform: translate(-50%, -50%); z-index: 12; font-size: 38rpx; pointer-events: none; animation: tutBounce 1.1s ease-in-out infinite; }
.tut-item-finger { position: absolute; top: -22rpx; left: 50%; transform: translateX(-50%); z-index: 12; font-size: 30rpx; pointer-events: none; animation: tutSlideX 1.1s ease-in-out infinite; }
@keyframes tutBounce { 0%, 100% { transform: translate(-50%, -65%); } 55% { transform: translate(-50%, 25%); } }
@keyframes tutSlideX { 0%, 100% { transform: translateX(-65%); } 55% { transform: translateX(-25%); } }

.slots-stack { flex: 1; display: flex; flex-direction: column; background: repeating-linear-gradient(90deg, #e6d5ba 0rpx 24rpx, #bfa07a 24rpx 27rpx); border: 3rpx solid #382110; border-radius: 8rpx; overflow: hidden; }
.cradle { flex: 1; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 6rpx; border-bottom: 6rpx solid #9c6531; position: relative; }
.pick-cradle { background: rgba(255,226,138,0.82); color: #5c3004; font-size: 28rpx; font-weight: bold; align-items: center; }

.grip-bar { height: 12rpx; margin: 4rpx 28rpx 0; border-radius: 999rpx; background: linear-gradient(180deg, #e5b869 0%, #9c6a23 100%); border: 2rpx solid #382110; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.grip-notch { width: 16rpx; height: 3rpx; background: rgba(56,33,16,0.55); border-radius: 2rpx; }

/* 规整化麻袋与铸铁秤砣组件 */
.p-cargo { position: relative; display: flex; flex-direction: column; align-items: stretch; }
.tier-1 { width: 68rpx; }
.tier-2 { width: 116rpx; }
.tier-3 { width: 164rpx; }
.p-cargo.selected { filter: drop-shadow(0 0 6rpx #e89b1c); }
.p-cargo.glow-ready { filter: drop-shadow(0 0 6rpx #37a16e); }

.done-seal { position: absolute; top: -8rpx; left: -6rpx; z-index: 6; width: 28rpx; height: 28rpx; border-radius: 50%; background: #37a16e; color: #fff; font-size: 18rpx; font-weight: bold; border: 2.5rpx solid #382110; display: flex; align-items: center; justify-content: center; }

.sacks-row { display: flex; gap: 4rpx; align-items: flex-end; justify-content: center; padding: 0 2rpx; }
.sack-unit { flex: 1; height: 48rpx; background: linear-gradient(180deg, #efd8b2 0%, #dfc08e 100%); border: 3rpx solid #382110; border-radius: 16rpx 16rpx 12rpx 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 5rpx 0 7rpx; }
.sack-cord { width: 76%; height: 7rpx; border-radius: 4rpx; border: 2rpx solid #382110; }
.sack-patch { width: 58%; height: 16rpx; border-radius: 4rpx; background: #fff9ee; border: 2rpx solid currentColor; }
.sack-fl-3 { color: #2b6f9e; }
.sack-fl-3 .sack-cord { background: #2b6f9e; }
.sack-fl-2 { color: #c97418; }
.sack-fl-2 .sack-cord { background: #c97418; }
.sack-fl-1 { color: #2a7c56; }
.sack-fl-1 .sack-cord { background: #2a7c56; }

.iron-unit { flex: 1; height: 46rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.iron-ring { width: 18rpx; height: 12rpx; border: 4rpx solid #261a10; border-radius: 50% 50% 0 0; margin-bottom: -3rpx; }
.iron-body { width: 100%; height: 34rpx; background: linear-gradient(180deg, #5c6a76 0%, #3d4750 100%); border: 3rpx solid #261a10; border-radius: 8rpx 8rpx 6rpx 6rpx; }

.wood-pallet { display: flex; gap: 3rpx; height: 10rpx; background: #382110; padding: 2rpx; border-radius: 4rpx; margin-top: -2rpx; }
.pallet-slat { flex: 1; background: #b57e46; border-radius: 2rpx; }

.swap-fab { position: absolute; top: -10rpx; right: -12rpx; width: 32rpx; height: 32rpx; border-radius: 50%; background: #f5ca64; border: 3rpx solid #382110; font-size: 19rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; }

.floors-bg { width: 100%; height: 100%; display: flex; flex-direction: column; }
.floor-band { height: 33.3333%; display: flex; }
.floor-band-3 { background: linear-gradient(180deg, #f6f0e4 0%, #efe5d2 100%); }
.floor-band-2 { background: linear-gradient(180deg, #f5ecdc 0%, #ecdfca 100%); }
.floor-band-1 { background: linear-gradient(180deg, #f2e9d8 0%, #e7d8c0 100%); }
.shaft-col { width: 200rpx; background: #dfd0b8; }
.shaft-left { border-right: 8rpx solid #825024; }
.shaft-right { border-left: 8rpx solid #825024; }

.platform { flex: 1; padding: 6rpx 8rpx 0; display: flex; flex-direction: column; }
.plat-head { display: flex; justify-content: space-between; align-items: center; min-height: 24rpx; }
.floor-watermark { color: rgba(94, 60, 34, 0.26); font-size: 20rpx; font-weight: 800; letter-spacing: 1rpx; padding-left: 4rpx; }
.meet-mark { font-size: 20rpx; color: rgba(92, 52, 9, 0.65); background: rgba(252,235,209,0.7); border: 2rpx solid rgba(56,33,16,0.28); padding: 0 8rpx; border-radius: 999rpx; font-weight: bold; }

.wall-niches { flex: 1; display: flex; flex-wrap: wrap; gap: 8rpx; align-items: center; justify-content: center; }
.plank-stage { display: flex; flex-wrap: wrap-reverse; gap: 8rpx; align-items: flex-end; justify-content: center; }
.timber-plank { height: 22rpx; margin: 0 -8rpx; background: linear-gradient(180deg, #d1995e 0%, #825024 100%); border-top: 3rpx solid #382110; border-bottom: 3rpx solid #382110; display: flex; justify-content: space-around; align-items: center; }
.iron-strap { width: 18rpx; height: 22rpx; background: #7d858c; border-left: 2rpx solid #382110; border-right: 2rpx solid #382110; }

.socket { border: 3rpx dashed; border-radius: 12rpx; padding: 6rpx 5rpx 4rpx; display: flex; flex-direction: column; gap: 4rpx; }
.socket-3 { border-color: rgba(43,111,158,0.5); color: #2b6f9e; background: rgba(215,235,250,0.42); }
.socket-2 { border-color: rgba(194,116,29,0.5); color: #c2741d; background: rgba(252,234,201,0.48); }
.socket-1 { border-color: rgba(42,124,86,0.5); color: #2a7c56; background: rgba(212,240,224,0.44); }
.s-sacks { display: flex; gap: 4rpx; height: 28rpx; }
.s-sack-ghost { flex: 1; border-radius: 10rpx 10rpx 6rpx 6rpx; background: currentColor; opacity: 0.2; }
.s-base { display: flex; gap: 4rpx; }
.s-pip { flex: 1; height: 6rpx; border-radius: 2rpx; background: currentColor; opacity: 0.36; }

.dock { padding: 10rpx 28rpx 20rpx; background: linear-gradient(180deg, #6b4323 0%, #533218 100%); border-top: 4rpx solid #382110; }
.util-row { display: flex; gap: 16rpx; justify-content: center; }
.u-btn { flex: 1; background: linear-gradient(180deg, #eed5b2 0%, #d4aa78 100%); border: 3rpx solid #382110; color: #382110; font-size: 28rpx; font-weight: bold; padding: 8rpx 0; border-radius: 16rpx; box-shadow: 0 5rpx 0 #38200e; }
.u-pass { background: linear-gradient(180deg, #ffe299 0%, #e5a93c 100%); }
.primary-btn { flex: 1; background: linear-gradient(180deg, #37a16e 0%, #237c52 100%); color: #ffffff; font-size: 26rpx; font-weight: bold; border: 3rpx solid #382110; border-radius: 16rpx; padding: 10rpx 0; box-shadow: 0 5rpx 0 #38200e; }

.modal-mask { position: fixed; inset: 0; z-index: 30; background: rgba(24,12,4,0.65); display: flex; align-items: center; justify-content: center; padding: 32rpx; }
.modal-card { width: 100%; max-height: 80vh; overflow-y: auto; background: linear-gradient(180deg, #fcf5e3 0%, #f5e8cc 100%); border: 5rpx solid #382110; border-radius: 26rpx; padding: 28rpx; }
.modal-title { font-size: 32rpx; font-weight: bold; margin-bottom: 12rpx; color: #382110; }
.modal-desc { font-size: 25rpx; color: #5e3c22; margin-bottom: 24rpx; }
.modal-btns { display: flex; gap: 16rpx; }
.lv-list { display: flex; flex-direction: column; gap: 12rpx; }
.lv-item { padding: 14rpx 18rpx; background: rgba(255,252,244,0.85); border: 3rpx solid #382110; border-radius: 16rpx; font-weight: bold; }
.lv-item.active { background: #fdeab8; }

@keyframes weapp-settle-hop {
  0% { transform: translateY(-28rpx) scale(1.1); opacity: 0.35; }
  55% { transform: translateY(3rpx) scale(0.96, 1.04); opacity: 1; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}
.p-cargo.just-settled { animation: weapp-settle-hop 0.34s cubic-bezier(0.22, 1, 0.36, 1); }

